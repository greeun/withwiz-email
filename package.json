{
  "name": "@withwiz/email",
  "version": "0.1.0",
  "description": "Provider-agnostic transactional email transports (Brevo, Mailjet, Resend, SMTP, console) with env-based selection",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "README.ko.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "nodemailer": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "nodemailer": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "nodemailer": "^9.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.0"
  },
  "engines": { "node": ">=18.17.0" },
  "packageManager": "pnpm@11.10.0",
  "license": "MIT",
  "author": "withwiz",
  "keywords": ["email", "transactional", "brevo", "mailjet", "resend", "smtp", "nodemailer", "withwiz"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeun/withwiz-email.git"
  }
}
